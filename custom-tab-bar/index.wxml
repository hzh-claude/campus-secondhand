<van-tabbar active="{{ active }}" active-color="#FF9500" inactive-color="#999999" bind:change="onChange">
  <van-tabbar-item icon="home-o">首页</van-tabbar-item>
  <van-tabbar-item icon="add-o">发布</van-tabbar-item>
  <!-- info 传空字符串 = 不显示徽标，有未读时显示数字（>99 显示 99+）。
       红点挂在「我的」而不是单独开一个 tab：「我的消息」本来就在
       「我的」里面，再开一个入口会让 tabBar 变成四个、挤得难看。
       未读数由页面在 onShow 时喂进来 —— 见 utils/unread.js -->
  <van-tabbar-item icon="user-o" info="{{unread > 0 ? unreadText : ''}}">我的</van-tabbar-item>
</van-tabbar>
