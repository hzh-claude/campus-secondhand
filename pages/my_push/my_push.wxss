/* pages/my_push/my_push.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.goods-list {
  padding: 20rpx;
}

.goods-item {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.goods-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.price {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF9500;
}

.stats {
  font-size: 24rpx;
  color: #999;
}

.goods-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 15rpx;
  margin-left: 15rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
  transition: all 0.3s;
}

/* 编辑按钮 */
.edit-btn {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #ddd;
}

/* 标记卖出按钮（绿色，和「已卖出」状态色一致） */
.sold-btn {
  background-color: #07c160;
  color: #fff;
  border: 1rpx solid #07c160;
}

/* 「已被预订」的提示文案：用橙色，和灰色的普通说明文字拉开层次 */
.locked-hint {
  color: #FF9500;
}

/* 已被预订的状态标签 */
.status.locked {
  background-color: #FFF3E0;
  color: #FF9500;
}

/* 「去处理」按钮：跳转到「我卖出的」处理订单 */
.go-btn {
  background-color: #FF9500;
  color: #fff;
  border: 1rpx solid #FF9500;
}

/* 下架按钮 */
.offsale-btn {
  background-color: #fff;
  color: #FF9500;
  border: 1rpx solid #FF9500;
}

/* 重新上架按钮 */
.resale-btn {
  background-color: #FF9500;
  color: #fff;
  border: 1rpx solid #FF9500;
}

/* 删除按钮 */
.delete-btn {
  background-color: #fff;
  color: #ee0a24;
  border: 1rpx solid #ee0a24;
}
