/* pages/my_favorite/my_favorite.wxss */
/* 布局和「我卖出的」保持一致，只是状态标签的语义不同 */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.goods-list {
  padding: 20rpx;
}

.goods-item {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background-color: #f0f0f0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.goods-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.price {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF9500;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* 还能买：绿色，和「我卖出的」的已卖出标签一致 */
.status.on-sale {
  background-color: #07c160;
  color: #fff;
}

/* 已经买不到了：灰色，视觉上主动降权 */
.status.unavailable {
  background-color: #eee;
  color: #999;
}

.goods-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 15rpx;
  margin-left: 15rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
}

.cancel-btn {
  background-color: #fff;
  color: #999;
  border: 1rpx solid #ddd;
}
