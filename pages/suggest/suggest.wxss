/* pages/suggest/suggest.wxss */
page {
  background-color: #f5f5f5;
  min-height: 100vh;
  /* padding-top 是删掉顶部提示条之后补上的。
     原来第一块内容靠那条横幅和导航栏拉开距离，横幅一删，
     「反馈类型」就贴在导航栏上了。 */
  padding-top: 20rpx;
  padding-bottom: 140rpx;
}

/* 注意：这里原来有一条 .notice-banner（「功能开发中」的橙色提示条）。
   功能做完了，它就成了假话，规则和 WXML 里那一块一起删掉了。
   不要再把它加回来。 */

.type-section,
.content-section,
.image-section,
.contact-section {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.type-item {
  padding: 16rpx 32rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.type-item.active {
  border-color: #FF9500;
  color: #FF9500;
  background-color: rgba(255, 149, 0, 0.1);
}

.feedback-textarea {
  width: 100%;
  height: 240rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-item .delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 8rpx;
}

.image-item.add-btn {
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #ddd;
}

.image-item.add-btn text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.contact-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 「我的反馈记录」入口。
   做成一行普通文字 + 箭头，不做成按钮 —— 它是次要动作，
   「提交反馈」才是这个页面唯一的主按钮。两个都做成橙色按钮的话，
   用户在底部会看到两个长得一样的东西，得读字才知道点哪个。 */
.history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  margin: 0 0 20rpx;
  padding: 30rpx;
  font-size: 28rpx;
  color: #333;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background-color: #FF9500;
  border-radius: 44rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

/* 提交中。
   写成一个复合选择器（.submit-btn.submitting）而不是单独一个类 ——
   这样它的特异性是 0,2,0，本来就压得过上面那个 0,1,0 的 .submit-btn，
   规则写在文件里哪个位置都生效。
   （它替换掉的 .submit-btn-disabled 是单独一个类，和 .submit-btn 同特异性，
     当时【必须】写在后面才盖得住。现在没有这个约束了。）

   名字和旧的 .submit-btn-disabled 不一样，是故意的：那个类名当时的语义是
   「功能没做，点不动」，和现在这个「正在提交」是完全相反的两件事。
   沿用旧名字会让后来人以为功能还是没做。 */
.submit-btn.submitting {
  background-color: #E0E0E0;
  color: #999;
}
