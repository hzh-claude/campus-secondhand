/* pages/delivery/delivery.wxss */

/* ⚠️ 这里【不能】用 .container 当页面根类名。
   app.wxss 里有一个同名的 .container，带着 display:flex、align-items:center、
   padding:200rpx 0 —— 页面自己的 .container 只写了背景色，那几个属性会
   照样漏进来，把收入条和 tab 全部挤成居中一列。
   （my_sold / my_push 的 wxss 里也有 .container，但它们的 wxml 根本没用这个类，
     所以一直没暴露。）背景改用 page 选择器。 */
page {
  background-color: #f5f5f5;
}

/* ============================================================
   三种非正常状态（确认中 / 没部署 / 不是配送员）
   ============================================================ */

/* 这三种状态都没有内容区块，全靠下面的 van-empty 撑高度，
   所以自己补一点上边距 */
.state-view {
  padding-top: 100rpx;
}

.hint {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  padding: 0 60rpx 20rpx;
  text-align: center;
}

.hint-sub {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
}

/* 云函数自报的版本号和白名单人数。
   比 hint-sub 更低一档：它是给「要动手排查的人」看的，
   不是给普通用户看的正文，所以用最浅的灰、最小的字号。
   见 delivery.js 里 cloudVersion 的注释。 */
.diag {
  font-size: 20rpx;
  color: #ccc;
  text-align: center;
  padding-bottom: 40rpx;
}

/* openid 那串 28 位字符。
   用等宽字体 + 自动折行：它本来就是拿来复制去粘贴的，
   折成两行比横向滚动好读，也比缩到看不清强。
   底色用浅灰而不是纯白，让它看起来像「一段可以拿走的数据」，
   而不是一段正文。 */
.openid {
  font-family: monospace;
  font-size: 24rpx;
  color: #333;
  word-break: break-all;
  line-height: 1.6;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 0 40rpx 16rpx;
}

/* ============================================================
   收入条
   ============================================================ */

/* 和「我卖出的」那条通知横条同一套视觉语言：浅橙底，
   它不是一个内容区块，是一句「你现在挣了多少」的结论 */
.income-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #FFF3E0;
  margin: 20rpx 20rpx 0;
  padding: 24rpx;
  border-radius: 12rpx;
}

.income-label {
  font-size: 24rpx;
  color: #E67700;
}

.income-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF9500;
  margin-top: 6rpx;
}

.income-count {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #E67700;
}

/* ============================================================
   列表
   ============================================================ */

.section {
  padding: 20rpx 20rpx 0;
}

.goods-item {
  display: flex;
  /* 配送中的卡片信息比图高（取货/送货/两个电话），
     用 flex-start 让商品图钉在顶部，而不是被拉去居中 */
  align-items: flex-start;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.goods-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.goods-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.price {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF9500;
}

/* 商品价格。三个 tab 里都挂在配送费旁边，比它低一档 ——
   在待接单里它是「凭什么收这个价」的依据，
   在配送中/已送达里它是「这笔账对不对」的核对。 */
.goods-price {
  font-size: 24rpx;
  color: #999;
}

/* ============================================================
   电话
   ============================================================ */

/* 电话这一行比普通说明文字重：它是配送员接下来要做的动作，
   不是背景信息 */
.contact {
  color: #333;
}

/* 「拨打」两个字做成橙色小胶囊。
   和 my_sold 的 .delivery-tag 一个道理 —— 它嵌在深色正文里，
   颜色字号都得显式写，不然会读成「卖家 13800000000拨打」一整串。 */
.call-btn {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  color: #FF9500;
  background-color: #FFF3E0;
  border-radius: 4rpx;
}

/* 【这里原来有 .status / .doing / .done 三个状态标签样式，已删】
   它们显示的是「小件」「大件」，而这两个词现在指的是价格档、
   跟体积无关，挂在卡片上只会误导。配送费本身已经把档位说清楚了。 */

/* ============================================================
   操作按钮（和「我卖出的」保持一致的色板）
   ============================================================ */

.goods-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 15rpx;
  margin-left: 15rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
  white-space: nowrap;
  transition: all 0.3s;
}

/* 接单 / 已送达：现在每张卡片上只剩这一个动作，全用实心橙。
   （原来还有个描边的 .reject-btn 给「改判」用，改判删掉后它也没了。） */
.confirm-btn {
  background-color: #FF9500;
  color: #fff;
}
